generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Lead {
  id Int @id @default(autoincrement())

  // Basic details
  fullName  String
  mobile    String
  whatsapp  String?
  email     String?
  address   String  @db.Text
  city      String?
  pincode   String?

  // Solar requirement
  propertyType    String
  monthlyBill     Int?
  monthlyUnits    Int?
  connectionType  String?
  capacity        String?
  roofType        String?
  installDate     DateTime?
  battery         String?
  finance         String?
  subsidy         String?
  message         String?  @db.Text

  // Admin / lead management
  status    String   @default("new")
  notes     String?  @db.Text

  // Metadata
  source    String   @default("website")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}

model Review {
  id Int @id @default(autoincrement())

  name       String
  city       String?
  rating     Int
  systemType String?
  comment    String @db.Text

  // Moderation - only "approved" reviews are shown publicly
  status String @default("pending")

  source    String   @default("website")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model GalleryItem {
  id      Int     @id @default(autoincrement())
  url     String  @db.Text
  type    String // "photo" | "video"
  caption String?
  order   Int     @default(0)

  createdAt DateTime @default(now())

  @@index([type])
  @@index([order])
}
