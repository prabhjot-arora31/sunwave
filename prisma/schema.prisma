generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Lead {
  id Int @id @default(autoincrement())

  // Basic details
  fullName  String
  mobile    String
  whatsapp  String?
  email     String?
  address   String  @db.Text
  city      String?
  pincode   String?

  // Solar requirement
  propertyType    String
  monthlyBill     Int?
  monthlyUnits    Int?
  connectionType  String?
  capacity        String?
  roofType        String?
  installDate     DateTime?
  battery         String?
  finance         String?
  subsidy         String?
  message         String?  @db.Text

  // Admin / lead management
  status    String   @default("new")
  notes     String?  @db.Text

  // Metadata
  source    String   @default("website")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status])

  invoices  Invoice[]
  projects  Project[]
  customer  Customer?
}

model Project {
  id Int @id @default(autoincrement())

  leadId Int?
  lead   Lead? @relation(fields: [leadId], references: [id])

  customerName    String
  customerPhone   String
  customerAddress String @db.Text

  capacity String
  stage    String @default("Site Survey")

  installDate         DateTime?
  commissioningDate   DateTime?
  subsidyCreditedDate DateTime?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([createdAt])
}

// A Customer is any real person/business we've saved details for - either
// auto-created the first time a document is attached to a lead (so the
// existing "add documents on the lead" flow keeps working unchanged), or
// created directly for a walk-in who never submitted the public inquiry
// form. leadId is optional and unique: at most one Customer per Lead, but a
// Customer need not have come from a Lead at all.
model Customer {
  id Int @id @default(autoincrement())

  fullName String
  phone    String
  address  String  @db.Text
  email    String?
  notes    String? @db.Text

  leadId Int?  @unique
  lead   Lead? @relation(fields: [leadId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents CustomerDocument[]
}

model CustomerDocument {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label    String
  url      String @db.Text
  fileName String

  createdAt DateTime @default(now())

  @@index([customerId])
}

model Invoice {
  id Int @id @default(autoincrement())

  invoiceNumber String @unique

  leadId Int?
  lead   Lead? @relation(fields: [leadId], references: [id])

  customerName    String
  customerPhone   String
  customerAddress String  @db.Text
  customerEmail   String?

  // Array of { description, quantity, rate, amount }
  items Json

  subtotal  Float
  gstRate   Float @default(5)
  gstAmount Float
  total     Float

  status      String   @default("Pending")
  invoiceDate DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([invoiceDate])
  @@index([status])
}

model Payment {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount Float
  method String
  paidOn DateTime @default(now())
  notes  String?

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

model AdminUser {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  // Flat map of permission key -> boolean, e.g. { "leads.view": true, ... }.
  // See src/lib/permissions.ts for the authoritative key list.
  permissions Json

  // The built-in "Owner" role: always full access, can't be edited or
  // deleted, guarantees there's always at least one fully-privileged role.
  isSystem Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminUsers AdminUser[]
}

// Singleton row (id is always 1) holding the site's frequently-edited
// marketing figures, so an admin can update them without a code deploy.
model SiteSettings {
  id Int @id @default(1)

  yearsExperience String
  happyCustomers  String
  mwCapacity      String
  citiesServed    String

  loanAmount    String
  interestRate  String
  loanTenure    String
  loanProcessing String

  financePartners Json
  subsidySlabs    Json

  updatedAt DateTime @updatedAt
}

model Review {
  id Int @id @default(autoincrement())

  name       String
  city       String?
  rating     Int
  systemType String?
  comment    String @db.Text

  // Moderation - only "approved" reviews are shown publicly
  status String @default("pending")

  source    String   @default("website")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model GalleryItem {
  id      Int     @id @default(autoincrement())
  url     String  @db.Text
  type    String // "photo" | "video"
  caption String?
  order   Int     @default(0)

  createdAt DateTime @default(now())

  @@index([type])
  @@index([order])
}

model BlogPost {
  id Int @id @default(autoincrement())

  title      String
  slug       String  @unique
  excerpt    String  @db.Text
  content    String  @db.Text // Markdown, rendered to HTML on the public page
  coverImage String? @db.Text

  published   Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([publishedAt])
}
