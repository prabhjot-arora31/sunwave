generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Lead {
  id Int @id @default(autoincrement())

  // Basic details
  fullName  String
  mobile    String
  whatsapp  String?
  email     String?
  address   String  @db.Text
  city      String?
  pincode   String?

  // Solar requirement
  propertyType    String
  monthlyBill     Int?
  monthlyUnits    Int?
  connectionType  String?
  capacity        String?
  roofType        String?
  installDate     DateTime?
  battery         String?
  finance         String?
  subsidy         String?
  message         String?  @db.Text

  // Admin / lead management
  status    String   @default("new")
  notes     String?  @db.Text

  // Metadata
  source    String   @default("website")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}
